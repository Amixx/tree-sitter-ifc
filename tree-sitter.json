{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ifc",
      "camelcase": "Ifc",
      "title": "Ifc",
      "scope": "source.ifc",
      "file-types": [
        "ifc"
      ],
      "injection-regex": "^ifc$",
      "class-name": "TreeSitterIfc",
      "highlights": "queries/highlights.scm"
    },
    {
      "name": "ifc_structured",
      "camelcase": "IfcStructured",
      "title": "Ifc structured",
      "scope": "source.ifc.structured",
      "path": "structured",
      "file-types": [],
      "class-name": "TreeSitterIfcStructured"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tree-sitter parser for ifc",
    "authors": [
      {
        "name": "Nepomuk Wolf",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-ifc",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
